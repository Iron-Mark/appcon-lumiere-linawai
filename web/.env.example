# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored and must never be committed.

# Gemini generation/verification (required)
GOOGLE_GENERATIVE_AI_API_KEY=

# Full URL of the deployed NLI backend (e.g. a dedicated Hugging Face
# Inference Endpoint running cross-encoder/nli-deberta-v3-base, or later our
# fine-tuned Linaw DeBERTa checkpoint). If absent, NLI is disabled
# (nli.enabled=false, nli.status="disabled") and /api/adapt still works
# normally via Gemini verification alone.
NLI_ENDPOINT=

# Optional Bearer token for a private NLI endpoint. Used only as
# Authorization for NLI_ENDPOINT - does not by itself enable NLI.
HUGGINGFACE_API_KEY=
