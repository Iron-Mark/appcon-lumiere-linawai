# Linaw AI — environment
#
# The app runs without a key. POST /api/adapt uses the offline fixture
# (lib/adapt/fixture.ts) until one of the keys below is set.
# Each live call spends tokens. Keep real keys out of git
# (.env* is ignored, this file is not).

# Provider order in app/api/adapt/model.ts: Gemini → OpenAI-compatible gateway → fixture.
# The result is labelled adapter: "model" | "fixture" so the UI can say which ran.

# 1) Gemini (primary). Empty means do not call Gemini. GEMINI_MODEL defaults to gemini-3.8-flash.
GEMINI_API_KEY=
GEMINI_MODEL=

# 2) OpenAI-compatible fallback (any /v1/chat/completions server). LLM_MODEL defaults to "auto".
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=

# Optional local NLI predict URL for lib/fidelity (e.g. http://127.0.0.1:8000/predict).
# Unset = disconnected stub (“Semantic check not connected”). Does not start the service.
# NLI_ENDPOINT is Node-only (evals, CI). For the browser Read path, also set the public var
# so the client bundle can call the same local predict URL.
NLI_ENDPOINT=
NEXT_PUBLIC_NLI_ENDPOINT=

# Optional account across phones and laptops. Both must be set or sign-in stays on this device only.
# Create a Supabase project, run supabase/migrations/20260924054800_linaw_profiles.sql,
# and turn off "Confirm email" so a second browser can sign in without an inbox.
# Use the publishable key. Never put the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: keep Next.js from sending anonymous telemetry in CI.
NEXT_TELEMETRY_DISABLED=1
