# Linaw AI — environment
#
# The app runs without a key. POST /api/adapt uses the offline fixture
# (lib/adapt/fixture.ts) until one of the keys below is set.
# Each live call spends tokens. Keep real keys out of git
# (.env* is ignored, this file is not).

# Google AI Studio / Gemini API key. Empty means do not call Gemini.
GEMINI_API_KEY=

# Optional local NLI predict URL for lib/fidelity (e.g. http://127.0.0.1:8000/predict).
# Unset = disconnected stub (“Semantic check not connected”). Does not start the service.
# NLI_ENDPOINT is Node-only (evals, CI). For the browser Read path, also set the public var
# so the client bundle can call the same local predict URL.
NLI_ENDPOINT=
NEXT_PUBLIC_NLI_ENDPOINT=

# Optional: keep Next.js from sending anonymous telemetry in CI.
NEXT_TELEMETRY_DISABLED=1
