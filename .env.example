# Linaw AI — environment
#
# The current build runs entirely in the browser with an offline sample
# adapter (lib/adapt/fixture.ts). No keys are required to run it.
#
# The live model path (spec/spec-02-gemini-adapt) is planned and not yet
# wired. When it is turned on it will read the key below. Each live call
# spends tokens; keep the key out of git (.env* is ignored, this file is not).

# Google AI Studio / Gemini API key — used only once lib/adapt/http.ts exists.
GEMINI_API_KEY=

# Optional local NLI predict URL for lib/fidelity (e.g. http://127.0.0.1:8000/predict).
# Unset = disconnected stub (“Semantic check not connected”). Does not start the service.
# NLI_ENDPOINT is Node-only (evals, CI). For the browser Read path, also set the public var
# so the client bundle can call the same local predict URL.
NLI_ENDPOINT=
NEXT_PUBLIC_NLI_ENDPOINT=

# Optional: keep Next.js from sending anonymous telemetry in CI.
NEXT_TELEMETRY_DISABLED=1
